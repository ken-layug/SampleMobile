<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">SampleMobile Notifications</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView Policy="@AuthorizationPolicies.AdminDashboard">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Overview</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="compose">Compose</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="devices">Registered devices</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="deliveries">Delivery history</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="simulator">Simulated provider tests</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="inbox">Inbox inspector</NavLink>
                </div>
                <div class="nav-item px-3 mt-3">
                    <form action="account/logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="_handler" value="logout" />
                        <button type="submit" class="nav-link btn btn-link text-start w-100">
                            Sign out (@context.User.Identity?.Name)
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/login">Sign in</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
