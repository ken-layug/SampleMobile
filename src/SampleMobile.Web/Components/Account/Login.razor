@page "/account/login"
@layout AccountLayout

<PageTitle>Sign in</PageTitle>

<h1 class="h4 mb-3">Administrator sign in</h1>

@if (!string.IsNullOrEmpty(ErrorMessage)) {
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
}

<EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login" Enhance="false">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="user-name" class="form-label">User name</label>
        <InputText id="user-name" class="form-control" autocomplete="username" @bind-Value="Input.UserName" />
        <ValidationMessage For="() => Input.UserName" />
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" type="password" class="form-control" autocomplete="current-password" @bind-Value="Input.Password" />
        <ValidationMessage For="() => Input.Password" />
    </div>
    <button type="submit" class="btn btn-primary w-100">Sign in</button>
</EditForm>

<p class="small text-muted mt-3 mb-0">
    Development seeds an administrator account; its credentials are in
    <code>appsettings.Development.json</code> under <code>DemoSeed</code>.
</p>
