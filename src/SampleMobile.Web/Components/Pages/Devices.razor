@page "/devices"
@attribute [Authorize(Policy = AuthorizationPolicies.AdminDashboard)]
@rendermode InteractiveServer

<PageTitle>Registered devices</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Registered devices</h1>
    <div class="d-flex gap-3 align-items-center">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="include-disabled"
                   checked="@IncludeDisabled" @onchange="ToggleIncludeDisabledAsync" />
            <label class="form-check-label small" for="include-disabled">Include disabled</label>
        </div>
        <AutoRefresh Interval="TimeSpan.FromSeconds(10)" StartEnabled="false" OnTick="LoadAsync" />
    </div>
</div>

<p class="small text-muted">
    One row per installation per provider. Provider addresses (FCM tokens and the like) are masked here and never
    returned by the mobile API.
</p>

@if (Data is null) {
    <p class="text-muted">Loading…</p>
} else {
    <DeviceRegistrationTable Items="Data.Items" />
    <Pager Page="Data.Page" TotalPages="Data.TotalPages" OnPageChanged="GoToPageAsync" />
}
