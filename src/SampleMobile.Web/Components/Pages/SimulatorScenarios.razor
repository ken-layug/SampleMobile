@page "/simulator"
@attribute [Authorize(Policy = AuthorizationPolicies.AdminDashboard)]
@rendermode InteractiveServer

<PageTitle>Simulated provider tests</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h3 mb-0">Simulated provider tests</h1>
    <AutoRefresh Interval="TimeSpan.FromSeconds(2)" OnTick="RefreshAsync" />
</div>

<div class="alert alert-primary small">
    Everything on this page goes through the <strong>simulated</strong> provider: no Firebase account, credentials,
    network or real device. "Accepted" here only means the simulator accepted the message. Each run (re-)registers the
    scenario's own virtual device for the chosen user with a fresh address, scripts the simulator's answers for that
    address, and saves a notification. The real delivery worker, retry policy and attempt history do the rest.
</div>

@if (Users is null) {
    <p class="text-muted">Loading…</p>
} else {
    <div class="row g-2 align-items-end mb-3">
        <div class="col-sm-6 col-lg-4">
            <label class="form-label small" for="scenario-user">Recipient</label>
            <select id="scenario-user" class="form-select form-select-sm" @bind="RecipientUserId">
                @foreach (var user in Users) {
                    <option @key="user.Id" value="@user.Id">@user.Label</option>
                }
            </select>
        </div>
    </div>

    <div class="row g-3 mb-3">
        @foreach (var scenario in Scenarios) {
            <div class="col-md-6 col-xl-3" @key="scenario.Scenario">
                <ScenarioCard Scenario="scenario.Scenario"
                              Title="@scenario.Title"
                              Description="@scenario.Description"
                              Expected="@scenario.Expected"
                              IsRunning="IsRunning"
                              OnRun="RunAsync" />
            </div>
        }
    </div>

    <ResultAlert Result="RunResult" />

    <h2 class="h5 mt-4">Recent simulated deliveries</h2>
    <DeliveryHistoryTable Items="Jobs" />

    <h2 class="h5 mt-4">Simulator message log</h2>
    <p class="small text-muted">What the simulator received, kept in memory only (cleared on restart). Attempts above are persisted.</p>
    <SimulatedMessageLogTable Messages="Messages" />
}
