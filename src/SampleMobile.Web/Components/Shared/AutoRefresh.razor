<div class="form-check form-switch d-inline-block">
    <input class="form-check-input" type="checkbox" role="switch" id="@_id" checked="@_enabled" @onchange="ToggleAsync" />
    <label class="form-check-label small" for="@_id">Auto-refresh every @Interval.TotalSeconds.ToString("0")s</label>
</div>
