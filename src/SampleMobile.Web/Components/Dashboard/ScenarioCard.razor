<div class="card h-100">
    <div class="card-body d-flex flex-column">
        <h2 class="h6 card-title">@Title</h2>
        <p class="small mb-2">@Description</p>
        <p class="small text-muted flex-grow-1 mb-3"><strong>Expect:</strong> @Expected</p>
        <button type="button" class="btn btn-sm btn-primary align-self-start" disabled="@IsRunning" @onclick="() => OnRun.InvokeAsync(Scenario)">
            Run scenario
        </button>
    </div>
</div>
