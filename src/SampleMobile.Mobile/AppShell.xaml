<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SampleMobile.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SampleMobile.Mobile.Views"
    Title="SampleMobile"
    FlyoutBehavior="Disabled">

    <TabBar x:Name="MainTabBar" Route="main">
        <Tab Title="Home">
            <ShellContent Route="home" ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="Inbox">
            <ShellContent Route="inbox" ContentTemplate="{DataTemplate views:InboxPage}" />
        </Tab>
        <Tab x:Name="DiagnosticsTab" Title="Diagnostics">
            <ShellContent Route="diagnostics" ContentTemplate="{DataTemplate views:DiagnosticsPage}" />
        </Tab>
    </TabBar>

</Shell>
