<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SampleMobile.Mobile.Core.ViewModels;assembly=SampleMobile.Mobile.Core"
             x:Class="SampleMobile.Mobile.Views.InboxPage"
             x:DataType="vm:InboxViewModel"
             Title="Inbox">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8,16,0" RowSpacing="8">
        <Label Grid.Row="0" Text="{Binding Summary}" Style="{StaticResource Caption}" />

        <Border Grid.Row="1" Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource BannerText}" />
        </Border>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView x:Name="Notifications"
                            ItemsSource="{Binding Items}"
                            SelectionMode="Single"
                            SelectionChanged="OnSelectionChanged">
                <CollectionView.EmptyView>
                    <Grid>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="8" Padding="24" IsVisible="{Binding IsEmpty}">
                            <Label Text="No notifications yet" HorizontalOptions="Center" Style="{StaticResource SectionTitle}" />
                            <Label Text="Pull down to refresh." HorizontalOptions="Center" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" VerticalOptions="Center" />
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NotificationItemViewModel">
                        <Grid ColumnDefinitions="16,*,Auto" RowDefinitions="Auto,Auto,Auto" Padding="0,10" ColumnSpacing="6">
                            <Ellipse Grid.RowSpan="3" WidthRequest="10" HeightRequest="10" VerticalOptions="Start" Margin="0,6,0,0"
                                     Fill="{StaticResource Primary}" IsVisible="{Binding IsUnread}" />
                            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Value}" FontFamily="OpenSansSemibold" MaxLines="1" LineBreakMode="TailTruncation" />
                            <Label Grid.Column="2" Text="{Binding CreatedAt}" Style="{StaticResource Caption}" />
                            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Preview}" MaxLines="2" LineBreakMode="TailTruncation" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Type}" Style="{StaticResource Caption}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
