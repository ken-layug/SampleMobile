<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Android only in this iteration. The provider-neutral code lives in SampleMobile.Mobile.Core. -->
        <TargetFramework Condition="'$(CI)' != 'true'">net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>SampleMobile.Mobile</RootNamespace>
        <UseMaui Condition="'$(CI)' != 'true'">true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>SampleMobile</ApplicationTitle>
        <!-- Must match the Android app registered in the Firebase console (google-services.json). -->
        <ApplicationId>xyz.kiaranet.samplemobile</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Firebase Android SDK (BoM 34+) needs API 23; 26 guarantees notification channels. -->
        <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
        <MauiFont Include="Resources\Fonts\*" />
    </ItemGroup>

    <!-- Optional client configuration from the Firebase console. Without it the app runs in inbox-only mode. -->
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\Platforms\Android\google-services.json')">
        <GoogleServicesJson Include="Platforms\Android\google-services.json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SampleMobile.Mobile.Core\SampleMobile.Mobile.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Central package management turns off MAUI's implicit references, so Controls is listed explicitly. -->
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Xamarin.Firebase.Messaging" />
    </ItemGroup>

    <!-- Aligns AndroidX Kotlin companions with the versions Firebase brings in (see Directory.Packages.props). -->
    <ItemGroup>
        <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
        <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" />
        <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    </ItemGroup>

</Project>
