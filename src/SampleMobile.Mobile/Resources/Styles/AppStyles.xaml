<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SampleMobile.Mobile.Converters">

    <converters:InvertedBoolConverter x:Key="InvertedBool" />

    <Color x:Key="DangerSurface">#FCE8E6</Color>
    <Color x:Key="InfoSurface">#E8F0FE</Color>
    <Color x:Key="WarningSurface">#FEF7E0</Color>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}" />
    </Style>

    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="BackgroundColor" Value="{StaticResource InfoSurface}" />
    </Style>

    <Style x:Key="ErrorBanner" TargetType="Border" BasedOn="{StaticResource Banner}">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerSurface}" />
    </Style>

    <Style x:Key="WarningBanner" TargetType="Border" BasedOn="{StaticResource Banner}">
        <Setter Property="BackgroundColor" Value="{StaticResource WarningSurface}" />
    </Style>

    <Style x:Key="BannerText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Gray900}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
    </Style>

    <Style x:Key="Value" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
</ResourceDictionary>
